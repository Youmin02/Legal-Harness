{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/legal-evidence-planning/input.schema.json",
  "title": "S1 legal evidence planning input",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mode", "run_id", "normalized_question", "query_history", "constraints"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "mode": {"const": "INITIAL_PLAN"},
        "run_id": {"type": "string", "minLength": 1},
        "original_question": {"type": "string"},
        "normalized_question": {"type": "string", "minLength": 1},
        "query_history": {"type": "array"},
        "constraints": {"$ref": "#/$defs/constraints"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "mode", "run_id", "normalized_question", "legal_issues", "required_evidence_items", "coverage_assessments", "missing_evidence_items", "evidence_conflicts", "query_history", "seen_provision_ids", "remaining_request_budget", "constraints"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "mode": {"const": "GAP_QUERY_PLAN"},
        "run_id": {"type": "string", "minLength": 1},
        "normalized_question": {"type": "string", "minLength": 1},
        "legal_issues": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "required_evidence_items": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "coverage_assessments": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "missing_evidence_items": {"type": "array", "items": {"type": "object"}},
        "evidence_conflicts": {"type": "array", "items": {"type": "object"}},
        "query_history": {"type": "array"},
        "seen_provision_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "remaining_request_budget": {"type": "integer", "minimum": 0},
        "constraints": {"$ref": "#/$defs/constraints"}
      }
    }
  ],
  "$defs": {
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_query_channels", "max_requests_per_issue"],
      "properties": {
        "allowed_query_channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["provision_style", "sparse_keywords", "statute_aware"]}
        },
        "max_requests_per_issue": {"type": "integer", "minimum": 1}
      }
    }
  }
}
