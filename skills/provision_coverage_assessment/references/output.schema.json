{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/provision-coverage-assessment/output.schema.json",
  "title": "S2 provision coverage assessment output",
  "oneOf": [
    {"$ref": "#/$defs/success"},
    {"$ref": "#/$defs/error"}
  ],
  "$defs": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_id", "evidence_item_id", "provision_id", "relation", "quoted_text", "rationale"],
      "properties": {
        "link_id": {"type": "string", "pattern": "^L[1-9][0-9]*$"},
        "evidence_item_id": {"type": "string", "pattern": "^E[1-9][0-9]*$"},
        "provision_id": {"type": "string", "minLength": 1},
        "relation": {"enum": ["supports", "partially_supports", "conflicts"]},
        "quoted_text": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_item_id", "status", "partial_kind", "linked_provision_ids", "rationale", "satisfied_aspects", "missing_aspects"],
      "properties": {
        "evidence_item_id": {"type": "string", "pattern": "^E[1-9][0-9]*$"},
        "status": {"enum": ["covered", "partially_covered", "uncovered", "conflicting"]},
        "partial_kind": {"enum": ["not_applicable", "factual_condition", "legal_support_gap"]},
        "linked_provision_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "rationale": {"type": "string", "minLength": 1},
        "satisfied_aspects": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "missing_aspects": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "legal_status": {"enum": ["covered", "partially_covered", "uncovered", "conflicting"]},
        "applicability_status": {"enum": ["direct", "conditional", "not_assessed"]},
        "gap_type": {"enum": ["none", "missing_statute", "missing_fact", "scope_excess", "conflict"]},
        "criterion_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement_id", "status", "linked_provision_ids", "rationale"],
            "properties": {
              "requirement_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["satisfied", "partially_satisfied", "unsatisfied", "conflicting"]},
              "linked_provision_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
              "rationale": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "missing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_item_id", "issue_id", "critical", "missing_description", "search_focus"],
      "properties": {
        "evidence_item_id": {"type": "string", "pattern": "^E[1-9][0-9]*$"},
        "issue_id": {"type": "string", "pattern": "^I[1-9][0-9]*$"},
        "critical": {"type": "boolean"},
        "missing_description": {"type": "string", "minLength": 1},
        "search_focus": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_id", "evidence_item_id", "provision_ids", "description", "unresolved_question"],
      "properties": {
        "conflict_id": {"type": "string", "pattern": "^CF[1-9][0-9]*$"},
        "evidence_item_id": {"type": "string", "pattern": "^E[1-9][0-9]*$"},
        "provision_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "description": {"type": "string", "minLength": 1},
        "unresolved_question": {"type": "string", "minLength": 1}
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "skill_id", "mode", "status", "run_id", "evidence_links", "coverage_assessments", "missing_evidence_items", "evidence_conflicts"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "skill_id": {"const": "S2"},
        "mode": {"const": "ASSESS_COVERAGE"},
        "status": {"const": "ok"},
        "run_id": {"type": "string", "minLength": 1},
        "evidence_links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
        "coverage_assessments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assessment"}},
        "missing_evidence_items": {"type": "array", "items": {"$ref": "#/$defs/missing"}},
        "evidence_conflicts": {"type": "array", "items": {"$ref": "#/$defs/conflict"}}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "skill_id", "mode", "status", "run_id", "error"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "skill_id": {"const": "S2"},
        "mode": {"const": "ASSESS_COVERAGE"},
        "status": {"const": "error"},
        "run_id": {"type": "string", "minLength": 1},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "details"],
          "properties": {
            "code": {"enum": ["INVALID_INPUT", "MISSING_REQUIRED_EVIDENCE", "CONTRACT_UNSATISFIABLE"]},
            "message": {"type": "string", "minLength": 1},
            "details": {"type": "array"}
          }
        }
      }
    }
  }
}
