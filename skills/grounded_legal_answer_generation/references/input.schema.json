{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/grounded-legal-answer-generation/input.schema.json",
  "title": "S3 grounded legal answer input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "run_id", "normalized_question", "legal_issues", "required_evidence_items", "coverage_assessments", "accepted_provisions", "authorization", "generation_purpose", "publishable", "candidate_answer_basis", "generation_constraints"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["GENERATE_ANSWER", "GENERATE_BENCHMARK_CANDIDATE"]},
    "run_id": {"type": "string", "minLength": 1},
    "normalized_question": {"type": "string", "minLength": 1},
    "legal_issues": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "answer_targets": {"type": "array", "items": {"type": "object"}},
    "required_evidence_items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "coverage_assessments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/assessment"}},
    "accepted_provisions": {"type": "array", "items": {"$ref": "#/$defs/provision"}},
    "candidate_provisions": {"type": "array", "items": {"$ref": "#/$defs/provision"}},
    "answer_mode": {"enum": ["full", "conditional", "limited", "abstain_candidate"]},
    "answered_target_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "deferred_target_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "authorized_by", "validated_state_version"],
      "properties": {
        "action": {"enum": ["GENERATE", "GENERATE_BENCHMARK_CANDIDATE"]},
        "authorized_by": {"enum": ["PROVISION_COVERAGE_POLICY", "HARNESS_BENCHMARK_DIAGNOSTIC"]},
        "validated_state_version": {"type": "integer", "minimum": 0}
      }
    },
    "generation_purpose": {"enum": ["published_answer", "benchmark_candidate"]},
    "publishable": {"type": "boolean"},
    "candidate_answer_basis": {"enum": ["published_answer", "retrieved_candidates", "question_only"]},
    "generation_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "max_answer_chars", "citation_marker_style"],
      "properties": {
        "language": {"type": "string", "minLength": 2},
        "max_answer_chars": {"type": "integer", "minimum": 1, "maximum": 800},
        "citation_marker_style": {"const": "citation_id"}
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["evidence_item_id", "issue_id", "critical"],
      "properties": {
        "evidence_item_id": {"type": "string", "pattern": "^E[1-9][0-9]*$"},
        "issue_id": {"type": "string", "pattern": "^I[1-9][0-9]*$"},
        "critical": {"type": "boolean"}
      }
    },
    "assessment": {
      "type": "object",
      "required": ["evidence_item_id", "status"],
      "properties": {
        "evidence_item_id": {"type": "string", "pattern": "^E[1-9][0-9]*$"},
        "status": {"enum": ["covered", "partially_covered", "uncovered", "conflicting"]}
      }
    },
    "provision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provision_id", "statute_name", "article_label", "text", "source_snapshot_id", "supported_evidence_item_ids"],
      "properties": {
        "provision_id": {"type": "string", "minLength": 1},
        "statute_name": {"type": "string", "minLength": 1},
        "article_label": {"type": "string", "minLength": 1},
        "heading": {"type": "string"},
        "text": {"type": "string", "minLength": 1},
        "source_snapshot_id": {"type": "string", "minLength": 1},
        "supported_evidence_item_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^E[1-9][0-9]*$"}, "uniqueItems": true}
      }
    }
  }
}
